<UserControl x:Class="PaneDock.App.Controls.ExplorerPane"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:PaneDock.App.Controls"
             MinWidth="215" MinHeight="175"
              PreviewMouseLeftButtonDown="Activate_OnMouseDown"
              PreviewMouseRightButtonDown="Activate_OnMouseDown"
              GotKeyboardFocus="Activate_OnFocus">
    <UserControl.Resources>
        <local:ShellIconConverter x:Key="ShellIconConverter"/>
        <local:GitStatusBadgeConverter x:Key="GitStatusBadgeConverter"/>
    </UserControl.Resources>
    <Border x:Name="OuterBorder" BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1" CornerRadius="8"
            AllowDrop="True" DragOver="Pane_DragOver" Drop="Pane_Drop"
            Background="{DynamicResource PanelBackground}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="34"/>
                <RowDefinition Height="38"/>
                <RowDefinition x:Name="FilterRow" Height="0"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="28"/>
            </Grid.RowDefinitions>
            <DockPanel Grid.Row="0" Background="{DynamicResource CardBackground}">
                <ToggleButton x:Name="TreeToggle" DockPanel.Dock="Left" Content="☷"
                              Width="28" Margin="4,3,0,3" ToolTip="폴더 트리"
                              AutomationProperties.Name="폴더 트리"
                              Background="{DynamicResource CardBackground}"
                              Foreground="{DynamicResource TextPrimary}"
                              BorderBrush="{DynamicResource BorderBrush}"
                              Checked="TreeToggle_Changed" Unchecked="TreeToggle_Changed"/>
                <TextBlock x:Name="PaneTitle" DockPanel.Dock="Left" VerticalAlignment="Center"
                           Margin="10,0" FontWeight="SemiBold"/>
                <Button DockPanel.Dock="Right" HorizontalAlignment="Right" Content="+"
                        Width="30" Padding="0" ToolTip="새 탭 (Ctrl+T)" Click="NewTab_Click"/>
                <TextBlock x:Name="GitBranchBadge" DockPanel.Dock="Right"
                           Visibility="Collapsed" VerticalAlignment="Center"
                           Margin="4,0,6,0" MaxWidth="90" FontSize="11"
                           TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource TextSecondary}"/>
                <TabControl x:Name="Tabs" SelectionChanged="Tabs_SelectionChanged"
                            BorderThickness="0" Padding="0"/>
            </DockPanel>
            <Grid Grid.Row="1" Margin="5,3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="←" ToolTip="뒤로 (Backspace, Alt+←)" Width="30" Padding="0" Click="Back_Click"/>
                <Button Grid.Column="1" Content="→" ToolTip="앞으로 (Alt+→)" Width="30" Padding="0" Click="Forward_Click"/>
                <Button Grid.Column="2" Content="↑" ToolTip="상위 폴더 (Alt+↑)" Width="30" Padding="0" Click="Up_Click"/>
                <Button Grid.Column="3" x:Name="DrivesButton" Content="PC" ToolTip="내 PC · 드라이브 목록" Width="34"
                        Padding="0" Click="Drives_Click"/>
                <Button Grid.Column="4" Content="바탕화면" Width="64" Padding="0" ToolTip="바탕화면 바로가기"
                        Click="Desktop_Click"/>
                <Grid Grid.Column="5" MinWidth="30">
                    <Border x:Name="BreadcrumbSurface" Background="{DynamicResource PanelBackground}"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                            CornerRadius="4" MouseLeftButtonDown="BreadcrumbSurface_MouseLeftButtonDown"
                            ToolTip="경로를 클릭해 이동, ✎ 또는 Ctrl+L / Alt+D / F4로 직접 입력">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ScrollViewer Grid.Column="0" x:Name="BreadcrumbScroll"
                                          VerticalScrollBarVisibility="Disabled"
                                          HorizontalScrollBarVisibility="Hidden"
                                          CanContentScroll="False" Focusable="False">
                                <StackPanel x:Name="BreadcrumbItems" Orientation="Horizontal"
                                            VerticalAlignment="Center"/>
                            </ScrollViewer>
                            <Button Grid.Column="1" Content="✎" Width="23" Padding="0"
                                    BorderThickness="0" Margin="0" MinHeight="0"
                                    ToolTip="경로 직접 입력 (Ctrl+L, Alt+D, F4)"
                                    AutomationProperties.Name="경로 직접 입력"
                                    Click="EditAddress_Click"/>
                        </Grid>
                    </Border>
                    <TextBox x:Name="Address" Visibility="Collapsed"
                             VerticalContentAlignment="Center"
                              KeyDown="Address_KeyDown" ToolTip="Enter: 경로 이동 · cmd: 현재 폴더에서 명령 프롬프트 · Esc: 취소"/>
                </Grid>
                <Button Grid.Column="6" Content="⌕" ToolTip="현재 폴더 필터 (Ctrl+F)" Width="30"
                        Padding="0" Click="ToggleFilter_Click"/>
                <Button Grid.Column="7" Content="↻" ToolTip="새로 고침 (F5, Ctrl+R)" Width="30" Padding="0" Click="Refresh_Click"/>
            </Grid>
            <Grid Grid.Row="2" x:Name="FilterPanel" Margin="7,0,7,3" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="파일명 필터" VerticalAlignment="Center"
                           Margin="1,0,8,0" Foreground="{DynamicResource TextSecondary}"/>
                <TextBox x:Name="FilterBox" Grid.Column="1" Margin="0,0,6,0" Padding="7,3"
                         VerticalContentAlignment="Center" ToolTip="파일명 부분 일치 필터"
                         TextChanged="FilterBox_TextChanged"/>
                <CheckBox x:Name="ShowHidden" Grid.Column="2" Content="숨김 표시"
                          Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"
                          Margin="2,0,6,0" Checked="ShowHidden_Changed"
                          Unchecked="ShowHidden_Changed"/>
                <Button Grid.Column="3" Content="×" Width="24" MinHeight="22" Padding="0"
                        ToolTip="필터 닫기 (Esc)" Click="ToggleFilter_Click"/>
            </Grid>
            <Grid Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="TreeColumn" Width="0" MaxWidth="230"/>
                    <ColumnDefinition Width="3*"/>
                </Grid.ColumnDefinitions>
                <TreeView x:Name="FolderTree" Visibility="Collapsed" Margin="5,0,0,0"
                          AllowDrop="True"
                          PreviewDragEnter="FolderTree_DragOver"
                          PreviewDragOver="FolderTree_DragOver"
                          PreviewDrop="FolderTree_Drop"
                          AutomationProperties.Name="폴더 탐색 트리"
                          Background="{DynamicResource PanelBackground}"
                          BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0"
                           Foreground="{DynamicResource TextPrimary}"
                           ScrollViewer.HorizontalScrollBarVisibility="Auto"
                           ScrollViewer.VerticalScrollBarVisibility="Auto"
                           VirtualizingStackPanel.IsVirtualizing="True"
                          VirtualizingStackPanel.VirtualizationMode="Recycling"
                          TreeViewItem.Expanded="FolderTree_Expanded"
                          SelectedItemChanged="FolderTree_SelectedItemChanged">
                </TreeView>
                <DataGrid x:Name="Files" Grid.Column="1" Margin="5,0"
                       InputMethod.IsInputMethodEnabled="False"
                       AllowDrop="True"
                       PreviewMouseLeftButtonDown="Files_DragSourceMouseDown"
                       PreviewMouseMove="Files_DragSourceMouseMove"
                       PreviewMouseLeftButtonUp="Files_DragSourceMouseUp"
                       PreviewDragEnter="Files_DragOver"
                       PreviewDragOver="Files_DragOver"
                       PreviewDrop="Files_Drop"
                      Background="{DynamicResource PanelBackground}"
                      Foreground="{DynamicResource TextPrimary}"
                      BorderThickness="0" GridLinesVisibility="None"
                      HeadersVisibility="Column" AutoGenerateColumns="False"
                      IsReadOnly="True" SelectionMode="Extended"
                      EnableRowVirtualization="True" EnableColumnVirtualization="True"
                      VirtualizingPanel.IsVirtualizing="True"
                      VirtualizingPanel.VirtualizationMode="Recycling"
                       ScrollViewer.CanContentScroll="True"
                       ScrollViewer.HorizontalScrollBarVisibility="Auto"
                       ScrollViewer.VerticalScrollBarVisibility="Auto"
                       AlternationCount="2" RowHeight="29"
                      ContextMenuOpening="Files_ContextMenuOpening"
                      PreviewMouseRightButtonDown="Files_PreviewMouseRightButtonDown"
                       MouseDoubleClick="Files_MouseDoubleClick"
                       Sorting="Files_Sorting"
                       SelectionChanged="Files_SelectionChanged">
                <DataGrid.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="새 폴더" Tag="NewFolder" InputGestureText="Ctrl+Shift+N" Click="FileCommand_Click"/>
                        <MenuItem Header="새 파일" Tag="NewFile" InputGestureText="Ctrl+Alt+N" Click="FileCommand_Click"/>
                        <MenuItem Header="이름 변경" Tag="Rename" InputGestureText="F2" Click="FileCommand_Click"/>
                        <Separator/>
                        <MenuItem Header="잘라내기" Tag="Cut" InputGestureText="Ctrl+X" Click="FileCommand_Click"/>
                        <MenuItem Header="복사" Tag="Copy" InputGestureText="Ctrl+C" Click="FileCommand_Click"/>
                        <MenuItem Header="붙여넣기" Tag="Paste" InputGestureText="Ctrl+V" Click="FileCommand_Click"/>
                        <Separator/>
                        <MenuItem Header="삭제" Tag="Delete" InputGestureText="Delete" Click="FileCommand_Click"/>
                        <MenuItem Header="영구 삭제" Tag="DeletePermanently" InputGestureText="Shift+Delete" Click="FileCommand_Click"/>
                    </ContextMenu>
                </DataGrid.ContextMenu>
                <DataGrid.Resources>
                    <Style TargetType="DataGridRow">
                        <Setter Property="Background" Value="{DynamicResource PanelBackground}"/>
                        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="{DynamicResource SelectionBrush}"/>
                            </Trigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource Self}}" Value="True"/>
                                    <Condition Binding="{Binding IsActivePane, RelativeSource={RelativeSource AncestorType={x:Type local:ExplorerPane}}}" Value="False"/>
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Background" Value="{DynamicResource InactiveSelectionBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                    <Style TargetType="DataGridCell">
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="{DynamicResource SelectionBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                            </Trigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource Self}}" Value="True"/>
                                    <Condition Binding="{Binding IsActivePane, RelativeSource={RelativeSource AncestorType={x:Type local:ExplorerPane}}}" Value="False"/>
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Background" Value="{DynamicResource InactiveSelectionBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="{DynamicResource CardBackground}"/>
                        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
                        <Setter Property="Padding" Value="8,5"/>
                    </Style>
                </DataGrid.Resources>
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="이름" SortMemberPath="Name"
                                            Width="SizeToCells" MinWidth="180" MaxWidth="1100">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Grid Width="22" Height="22" Margin="2,0,7,0"
                                          VerticalAlignment="Center">
                                        <Image x:Name="NativeFileIcon" Width="16" Height="16"
                                               Source="{Binding Converter={StaticResource ShellIconConverter}}"/>
                                        <TextBlock Text="{Binding IconGlyph}" FontFamily="Segoe UI Emoji"
                                                   FontSize="14" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Source, ElementName=NativeFileIcon}"
                                                                     Value="{x:Null}">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <ContentControl Width="9" Height="9" Padding="0"
                                                        HorizontalAlignment="Left" VerticalAlignment="Bottom"
                                                        Focusable="False">
                                            <ContentControl.Style>
                                                <Style TargetType="ContentControl">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Style.Triggers>
                                                        <!-- A null Git status must not render an empty
                                                             badge background for ignored/non-Git files. -->
                                                        <Trigger Property="Content" Value="{x:Null}">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ContentControl.Style>
                                            <ContentControl.Content>
                                                <MultiBinding Converter="{StaticResource GitStatusBadgeConverter}">
                                                    <Binding Path="FullPath"/>
                                                    <Binding Path="IsDirectory"/>
                                                    <Binding Path="GitSnapshot" RelativeSource="{RelativeSource AncestorType={x:Type local:ExplorerPane}}"/>
                                                </MultiBinding>
                                            </ContentControl.Content>
                                            <ContentControl.ContentTemplate>
                                                <DataTemplate>
                                                    <Border Background="{DynamicResource PanelBackground}"
                                                            CornerRadius="2"
                                                            ToolTip="{Binding Description}">
                                                        <Viewbox Width="9" Height="9" Stretch="Uniform">
                                                            <TextBlock Text="{Binding Symbol}"
                                                                       Foreground="{Binding Color}"
                                                                       FontSize="12" FontWeight="Bold"
                                                                       TextAlignment="Center"/>
                                                        </Viewbox>
                                                    </Border>
                                                </DataTemplate>
                                            </ContentControl.ContentTemplate>
                                        </ContentControl>
                                    </Grid>
                                    <TextBlock Text="{Binding Name}" ToolTip="{Binding Name}"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="확장자" Binding="{Binding Extension}" SortMemberPath="Extension" Width="70"/>
                    <DataGridTextColumn Header="크기" Binding="{Binding DisplaySize}" SortMemberPath="Size" Width="85"/>
                    <DataGridTextColumn Header="유형" Binding="{Binding Kind}" SortMemberPath="Kind" Width="95"/>
                    <DataGridTextColumn Header="수정한 날짜" Binding="{Binding DisplayModifiedAt}" SortMemberPath="ModifiedAt" Width="135"/>
                    <DataGridTextColumn Header="생성 날짜" Binding="{Binding DisplayCreatedAt}" SortMemberPath="CreatedAt" Width="135"/>
                </DataGrid.Columns>
                </DataGrid>
            </Grid>
            <DockPanel Grid.Row="4" Margin="9,0" LastChildFill="True">
                <TextBlock x:Name="Status" Foreground="{DynamicResource TextSecondary}"
                           VerticalAlignment="Center" Text="준비됨"/>
            </DockPanel>
        </Grid>
    </Border>
</UserControl>
