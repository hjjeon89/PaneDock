<UserControl x:Class="PaneDock.App.Controls.ExplorerPane"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="215" MinHeight="175"
             PreviewKeyDown="Pane_PreviewKeyDown"
             GotKeyboardFocus="Activate_OnFocus">
    <Border x:Name="OuterBorder" BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1" CornerRadius="8"
            Background="{DynamicResource PanelBackground}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="34"/>
                <RowDefinition Height="38"/>
                <RowDefinition x:Name="FilterRow" Height="0"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="28"/>
            </Grid.RowDefinitions>
            <DockPanel Grid.Row="0" Background="{DynamicResource CardBackground}">
                <ToggleButton x:Name="TreeToggle" DockPanel.Dock="Left" Content="☷"
                              Width="28" Margin="4,3,0,3" ToolTip="폴더 트리"
                              AutomationProperties.Name="폴더 트리"
                              Background="{DynamicResource CardBackground}"
                              Foreground="{DynamicResource TextPrimary}"
                              BorderBrush="{DynamicResource BorderBrush}"
                              Checked="TreeToggle_Changed" Unchecked="TreeToggle_Changed"/>
                <TextBlock x:Name="PaneTitle" DockPanel.Dock="Left" VerticalAlignment="Center"
                           Margin="10,0" FontWeight="SemiBold"/>
                <Button DockPanel.Dock="Right" HorizontalAlignment="Right" Content="+"
                        Width="30" Padding="0" ToolTip="새 탭" Click="NewTab_Click"/>
                <TabControl x:Name="Tabs" SelectionChanged="Tabs_SelectionChanged"
                            BorderThickness="0" Padding="0"/>
            </DockPanel>
            <Grid Grid.Row="1" Margin="5,3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="←" ToolTip="뒤로" Width="30" Padding="0" Click="Back_Click"/>
                <Button Grid.Column="1" Content="→" ToolTip="앞으로" Width="30" Padding="0" Click="Forward_Click"/>
                <Button Grid.Column="2" Content="↑" ToolTip="상위 폴더" Width="30" Padding="0" Click="Up_Click"/>
                <Button Grid.Column="3" x:Name="DrivesButton" Content="PC" ToolTip="내 PC · 드라이브 목록" Width="34"
                        Padding="0" Click="Drives_Click"/>
                <Button Grid.Column="4" Content="바탕화면" Width="64" Padding="0" ToolTip="바탕화면 바로가기"
                        Click="Desktop_Click"/>
                <Grid Grid.Column="5" MinWidth="30">
                    <Border x:Name="BreadcrumbSurface" Background="{DynamicResource PanelBackground}"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                            CornerRadius="4" MouseLeftButtonDown="BreadcrumbSurface_MouseLeftButtonDown"
                            ToolTip="경로를 클릭해 이동, ✎ 또는 Ctrl+L로 직접 입력">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ScrollViewer Grid.Column="0" x:Name="BreadcrumbScroll"
                                          VerticalScrollBarVisibility="Disabled"
                                          HorizontalScrollBarVisibility="Hidden"
                                          CanContentScroll="False" Focusable="False">
                                <StackPanel x:Name="BreadcrumbItems" Orientation="Horizontal"
                                            VerticalAlignment="Center"/>
                            </ScrollViewer>
                            <Button Grid.Column="1" Content="✎" Width="23" Padding="0"
                                    BorderThickness="0" Margin="0" MinHeight="0"
                                    ToolTip="경로 직접 입력 (Ctrl+L)"
                                    AutomationProperties.Name="경로 직접 입력"
                                    Click="EditAddress_Click"/>
                        </Grid>
                    </Border>
                    <TextBox x:Name="Address" Visibility="Collapsed"
                             VerticalContentAlignment="Center"
                             KeyDown="Address_KeyDown" ToolTip="Enter: 이동 / Esc: 취소"/>
                </Grid>
                <Button Grid.Column="6" Content="⌕" ToolTip="현재 폴더 필터 (Ctrl+F)" Width="30"
                        Padding="0" Click="ToggleFilter_Click"/>
                <Button Grid.Column="7" Content="↻" ToolTip="새로 고침 (F5)" Width="30" Padding="0" Click="Refresh_Click"/>
            </Grid>
            <Grid Grid.Row="2" x:Name="FilterPanel" Margin="7,0,7,3" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="파일명 필터" VerticalAlignment="Center"
                           Margin="1,0,8,0" Foreground="{DynamicResource TextSecondary}"/>
                <TextBox x:Name="FilterBox" Grid.Column="1" Margin="0,0,6,0" Padding="7,3"
                         VerticalContentAlignment="Center" ToolTip="파일명 부분 일치 필터"
                         TextChanged="FilterBox_TextChanged"/>
                <CheckBox x:Name="ShowHidden" Grid.Column="2" Content="숨김 표시"
                          Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"
                          Margin="2,0,6,0" Checked="ShowHidden_Changed"
                          Unchecked="ShowHidden_Changed"/>
                <Button Grid.Column="3" Content="×" Width="24" MinHeight="22" Padding="0"
                        ToolTip="필터 닫기 (Esc)" Click="ToggleFilter_Click"/>
            </Grid>
            <Grid Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="TreeColumn" Width="0" MaxWidth="230"/>
                    <ColumnDefinition Width="3*"/>
                </Grid.ColumnDefinitions>
                <TreeView x:Name="FolderTree" Visibility="Collapsed" Margin="5,0,0,0"
                          AutomationProperties.Name="폴더 탐색 트리"
                          Background="{DynamicResource PanelBackground}"
                          BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0"
                          Foreground="{DynamicResource TextPrimary}"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto"
                          VirtualizingStackPanel.IsVirtualizing="True"
                          VirtualizingStackPanel.VirtualizationMode="Recycling"
                          TreeViewItem.Expanded="FolderTree_Expanded"
                          SelectedItemChanged="FolderTree_SelectedItemChanged">
                    <TreeView.Resources>
                        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}"
                                         Color="{Binding Color, Source={StaticResource SelectionBrush}}"/>
                        <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}"
                                         Color="{Binding Color, Source={StaticResource SelectionBrush}}"/>
                    </TreeView.Resources>
                </TreeView>
                <DataGrid x:Name="Files" Grid.Column="1" Margin="5,0"
                      Background="{DynamicResource PanelBackground}"
                      Foreground="{DynamicResource TextPrimary}"
                      BorderThickness="0" GridLinesVisibility="None"
                      HeadersVisibility="Column" AutoGenerateColumns="False"
                      IsReadOnly="True" SelectionMode="Extended"
                      EnableRowVirtualization="True" EnableColumnVirtualization="True"
                      VirtualizingPanel.IsVirtualizing="True"
                      VirtualizingPanel.VirtualizationMode="Recycling"
                      ScrollViewer.CanContentScroll="True"
                      AlternationCount="2" RowHeight="29"
                      ContextMenuOpening="Files_ContextMenuOpening"
                      PreviewMouseRightButtonDown="Files_PreviewMouseRightButtonDown"
                       MouseDoubleClick="Files_MouseDoubleClick"
                       Sorting="Files_Sorting"
                       SelectionChanged="Files_SelectionChanged">
                <DataGrid.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="새 폴더" Tag="NewFolder" InputGestureText="Ctrl+Shift+N" Click="FileCommand_Click"/>
                        <MenuItem Header="이름 변경" Tag="Rename" InputGestureText="F2" Click="FileCommand_Click"/>
                        <Separator/>
                        <MenuItem Header="잘라내기" Tag="Cut" InputGestureText="Ctrl+X" Click="FileCommand_Click"/>
                        <MenuItem Header="복사" Tag="Copy" InputGestureText="Ctrl+C" Click="FileCommand_Click"/>
                        <MenuItem Header="붙여넣기" Tag="Paste" InputGestureText="Ctrl+V" Click="FileCommand_Click"/>
                        <Separator/>
                        <MenuItem Header="삭제" Tag="Delete" InputGestureText="Delete" Click="FileCommand_Click"/>
                    </ContextMenu>
                </DataGrid.ContextMenu>
                <DataGrid.Resources>
                    <Style TargetType="DataGridRow">
                        <Setter Property="Background" Value="{DynamicResource PanelBackground}"/>
                        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="{DynamicResource SelectionBrush}"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                    <Style TargetType="DataGridCell">
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                    </Style>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="{DynamicResource CardBackground}"/>
                        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
                        <Setter Property="Padding" Value="8,5"/>
                    </Style>
                </DataGrid.Resources>
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="이름" SortMemberPath="Name" Width="*" MinWidth="100">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding IconGlyph}" FontFamily="Segoe UI Emoji"
                                               FontSize="14" Margin="2,0,7,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="확장자" Binding="{Binding Extension}" SortMemberPath="Extension" Width="70"/>
                    <DataGridTextColumn Header="크기" Binding="{Binding DisplaySize}" SortMemberPath="Size" Width="85"/>
                    <DataGridTextColumn Header="유형" Binding="{Binding Kind}" SortMemberPath="Kind" Width="95"/>
                    <DataGridTextColumn Header="수정한 날짜" Binding="{Binding DisplayModifiedAt}" SortMemberPath="ModifiedAt" Width="135"/>
                    <DataGridTextColumn Header="생성 날짜" Binding="{Binding DisplayCreatedAt}" SortMemberPath="CreatedAt" Width="135"/>
                </DataGrid.Columns>
                </DataGrid>
            </Grid>
            <DockPanel Grid.Row="4" Margin="9,0" LastChildFill="True">
                <TextBlock x:Name="Status" Foreground="{DynamicResource TextSecondary}"
                           VerticalAlignment="Center" Text="준비됨"/>
            </DockPanel>
        </Grid>
    </Border>
</UserControl>
