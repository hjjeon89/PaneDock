<Window x:Class="PaneDock.App.SearchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PaneDock · 파일 검색" Icon="Assets/PaneDock.ico"
        Width="1050" Height="690" MinWidth="720" MinHeight="460"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackground}"
        Foreground="{DynamicResource TextPrimary}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="검색어" VerticalAlignment="Center" Margin="0,0,10,0" FontWeight="SemiBold"/>
            <TextBox Grid.Column="1" x:Name="QueryBox" Height="32"
                     VerticalContentAlignment="Center" KeyDown="Query_KeyDown"
                     ToolTip="이름에 포함된 단어 검색 (대소문자 구분 없음)"/>
            <Button Grid.Column="2" x:Name="SearchButton" Content="⌕ 검색"
                    Margin="8,0,0,0" Padding="18,4" Click="Search_Click"/>
        </Grid>
        <Grid Grid.Row="1" Margin="0,10,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="검색 위치" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <TextBox Grid.Column="1" x:Name="RootBox" Height="29" VerticalContentAlignment="Center"
                     ToolTip="현재 폴더, C:\, D:\ 또는 네트워크 공유 경로 입력"/>
            <CheckBox Grid.Column="2" x:Name="RecursiveBox" IsChecked="True"
                      Content="하위 폴더 포함" VerticalAlignment="Center" Margin="14,0,12,0"/>
            <Button Grid.Column="3" x:Name="CancelButton" Content="중지"
                    Click="Cancel_Click" IsEnabled="False" Padding="14,3"/>
        </Grid>
        <DataGrid Grid.Row="2" x:Name="ResultGrid" IsReadOnly="True" AutoGenerateColumns="False"
                  EnableRowVirtualization="True" SelectionMode="Single"
                  Background="{DynamicResource PanelBackground}"
                  Foreground="{DynamicResource TextPrimary}"
                  GridLinesVisibility="None"
                  MouseDoubleClick="Results_DoubleClick">
            <DataGrid.Columns>
                <DataGridTextColumn Header="이름" Binding="{Binding Name}" Width="2*" MinWidth="110"/>
                <DataGridTextColumn Header="경로" Binding="{Binding FolderPath}" Width="3*" MinWidth="170"/>
                <DataGridTextColumn Header="유형" Binding="{Binding Type}" Width="65"/>
                <DataGridTextColumn Header="크기" Binding="{Binding SizeText}" Width="100"/>
                <DataGridTextColumn Header="수정 날짜" Binding="{Binding ModifiedText}" Width="140"/>
            </DataGrid.Columns>
        </DataGrid>
        <DockPanel Grid.Row="3" Margin="0,10,0,0" LastChildFill="True">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="위치 열기" Padding="14,4" Margin="0,0,8,0"
                        Click="OpenLocation_Click" ToolTip="선택 항목의 부모 폴더를 PaneDock에서 열기"/>
                <Button Content="파일 열기" Padding="14,4" Click="OpenResult_Click"
                        ToolTip="Windows 연결 프로그램에서 파일 또는 폴더 열기"/>
            </StackPanel>
            <TextBlock x:Name="StatusText" Text="검색어와 위치를 지정하세요."
                       VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}"/>
        </DockPanel>
    </Grid>
</Window>
