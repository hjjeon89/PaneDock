<Window x:Class="PaneDock.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:PaneDock.App"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="PaneDock" WindowStyle="None"
        Icon="Assets/PaneDock.ico"
        Background="{DynamicResource WindowBackground}"
        Foreground="{DynamicResource TextPrimary}"
        Width="1440" Height="900" MinWidth="760" MinHeight="550"
        PreviewKeyDown="Window_PreviewKeyDown"
        WindowStartupLocation="CenterScreen">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="44" ResizeBorderThickness="6" GlassFrameThickness="0"
                            CornerRadius="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>
    <Grid Margin="16,0,16,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="44"/>
            <RowDefinition Height="52"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="40"/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0">
            <Grid.Resources>
                <Style x:Key="WindowButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                    <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
                    <Setter Property="FontSize" Value="11"/>
                    <Setter Property="Width" Value="44"/>
                    <Setter Property="Height" Value="36"/>
                    <Setter Property="Margin" Value="0"/>
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="Background" Value="Transparent"/>
                </Style>
            </Grid.Resources>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                <Image Source="Assets/PaneDock.png" Width="27" Height="27"
                       Margin="0,0,9,0" Stretch="Uniform"
                       AutomationProperties.Name="PaneDock 프로그램 아이콘"/>
                <TextBlock Text="PaneDock" FontSize="16" FontWeight="SemiBold"
                           VerticalAlignment="Center" Margin="0,0,20,0"/>
                <TextBox x:Name="GlobalSearchBox" Width="224" Height="28"
                          VerticalContentAlignment="Center" ToolTip="전체 검색 (Ctrl+E, F3) · Enter: 검색 · Esc: 닫기"
                         shell:WindowChrome.IsHitTestVisibleInChrome="True"
                         TextChanged="GlobalSearch_TextChanged"
                         KeyDown="GlobalSearch_KeyDown"
                         AutomationProperties.Name="파일 검색어"/>
                <Button x:Name="GlobalSearchButton" Content="⌕" Margin="6,0,0,0" Width="32" Padding="0"
                         shell:WindowChrome.IsHitTestVisibleInChrome="True"
                         ToolTip="상단 검색 결과 표시 · 검색 실행"
                         Click="OpenSearch_Click"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True">
                <Button x:Name="ShortcutHelpButton" Content="?" Width="30" Height="28"
                        Padding="0" Margin="0,0,8,0" FontSize="15" FontWeight="Bold"
                        ToolTip="단축키 도움말 (F1)"
                        AutomationProperties.Name="단축키 도움말"
                        Click="ShortcutHelp_Click"/>
                <Button x:Name="ThemeButton" Content="◐ Light" ToolTip="현재 Light · Dark로 변경"
                         Click="Theme_Click" Margin="0,0,10,0" VerticalAlignment="Center" Padding="12,4"/>
                <Button Style="{StaticResource WindowButton}" Content="&#xE921;"
                        AutomationProperties.Name="최소화" ToolTip="최소화" Click="Minimize_Click"/>
                <Button Click="Maximize_Click">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource WindowButton}">
                            <Setter Property="Content" Value="&#xE922;"/>
                            <Setter Property="ToolTip" Value="최대화"/>
                            <Setter Property="AutomationProperties.Name" Value="최대화"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}"
                                             Value="Maximized">
                                    <Setter Property="Content" Value="&#xE923;"/>
                                    <Setter Property="ToolTip" Value="이전 크기로 복원"/>
                                    <Setter Property="AutomationProperties.Name" Value="이전 크기로 복원"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Style="{StaticResource WindowButton}" Content="&#xE8BB;"
                        AutomationProperties.Name="닫기" ToolTip="닫기" Click="Close_Click"/>
            </StackPanel>
        </Grid>
        <DockPanel Grid.Row="1" LastChildFill="False" VerticalAlignment="Center">
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                <TextBlock Text="레이아웃" VerticalAlignment="Center" Margin="4,0,10,0"
                           Foreground="{DynamicResource TextSecondary}" FontWeight="SemiBold"/>
                <Button Tag="Single" Content="▣  1" ToolTip="단일 패널" Click="Layout_Click"/>
                <Button Tag="TwoColumns" Content="◫  2↔" ToolTip="좌우 2분할" Click="Layout_Click"/>
                <Button Tag="TwoRows" Content="⊟  2↕" ToolTip="상하 2분할" Click="Layout_Click"/>
                <Button Tag="ThreeLeft" Content="▥  3L" ToolTip="왼쪽 1개, 오른쪽 상하 2개" Click="Layout_Click"/>
                <Button Tag="ThreeTop" Content="▤  3T" ToolTip="위쪽 1개, 아래쪽 좌우 2개" Click="Layout_Click"/>
                <Button Tag="FourGrid" Content="▦  4" ToolTip="2×2 4분할" Click="Layout_Click"/>
            </StackPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="일괄 변경" ToolTip="선택 파일의 이름/확장자 일괄 변경과 미리보기"
                        Click="BatchRename_Click"/>
            </StackPanel>
        </DockPanel>
        <Grid Grid.Row="2" x:Name="PaneHost" Margin="0,4,0,8"/>
        <Grid Grid.Row="3" VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="Activity" Text="활성 패널"
                       Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis"/>
            <TextBlock x:Name="SelectedItemsSummary" Grid.Column="1"
                       Text="선택 항목 없음" VerticalAlignment="Center"
                       Margin="12,0,14,0" Foreground="{DynamicResource TextSecondary}"/>
            <Button x:Name="FolderSummaryButton" Grid.Column="2"
                    Content="📁 폴더를 선택하면 파일 수·용량 계산"
                    Height="30" Padding="12,3" IsEnabled="False"
                    AutomationProperties.Name="하단 폴더 분석"
                    ToolTip="선택한 폴더들의 파일 수·하위 폴더 수·총용량 · 클릭하면 폴더별 상세 표시"
                    Click="FolderSummary_Click"/>
        </Grid>
        <Popup x:Name="FolderBreakdownPopup" Placement="Top" StaysOpen="False"
               AllowsTransparency="True" VerticalOffset="-5"
               PlacementTarget="{Binding ElementName=FolderSummaryButton}">
            <Border Background="{DynamicResource CardBackground}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                    CornerRadius="8" Padding="12">
                <Grid Width="690">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="245"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <DockPanel Grid.Row="0" Margin="0,0,0,9">
                        <Button DockPanel.Dock="Right" Content="↻ 다시 계산"
                                Padding="10,4" Click="FolderSummaryRefresh_Click"/>
                        <TextBlock Text="선택 폴더별 상세 분석" FontWeight="SemiBold"
                                   FontSize="13" VerticalAlignment="Center"/>
                    </DockPanel>
                    <DataGrid Grid.Row="1" x:Name="FolderBreakdownGrid"
                              AutoGenerateColumns="False" IsReadOnly="True"
                              Background="{DynamicResource PanelBackground}"
                              Foreground="{DynamicResource TextPrimary}"
                              GridLinesVisibility="None"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              EnableRowVirtualization="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="폴더" Binding="{Binding Path}"
                                                Width="SizeToCells" MinWidth="220" MaxWidth="800"/>
                            <DataGridTextColumn Header="파일 수"
                                                Binding="{Binding FileCount, StringFormat=N0}" Width="85"/>
                            <DataGridTextColumn Header="하위 폴더"
                                                Binding="{Binding SubfolderCount, StringFormat=N0}" Width="90"/>
                            <DataGridTextColumn Header="총용량" Binding="{Binding SizeText}" Width="100"/>
                            <DataGridTextColumn Header="건너뜀"
                                                Binding="{Binding SkippedFolders}" Width="75"/>
                            <DataGridTextColumn Header="오류" Binding="{Binding Error}" Width="120"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Grid.Row="2" x:Name="FolderBreakdownStatus" Margin="0,9,0,0"
                               Text="선택한 폴더를 분석하고 있습니다."
                               Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap"/>
                </Grid>
            </Border>
        </Popup>
        <Popup x:Name="SearchPopup" Placement="Bottom" StaysOpen="False"
               AllowsTransparency="True" VerticalOffset="5"
               PlacementTarget="{Binding ElementName=GlobalSearchBox}"
               Opened="SearchPopup_Opened" Closed="SearchPopup_Closed">
            <local:SearchPanel x:Name="SearchPanel"/>
        </Popup>
        <Popup x:Name="ShortcutHelpPopup" Placement="Bottom" StaysOpen="False"
               AllowsTransparency="True" VerticalOffset="6" HorizontalOffset="-495"
               PlacementTarget="{Binding ElementName=ShortcutHelpButton}">
            <Border Width="530" Padding="14" CornerRadius="9"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                    Background="{DynamicResource CardBackground}"
                    PreviewKeyDown="ShortcutHelp_PreviewKeyDown">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <DockPanel Margin="0,0,0,10">
                        <Button DockPanel.Dock="Right" Content="×"
                                Width="28" Height="28" MinHeight="0" Padding="0"
                                ToolTip="단축키 도움말 닫기 (Esc)"
                                AutomationProperties.Name="도움말 닫기"
                                Click="ShortcutHelpClose_Click"/>
                        <StackPanel>
                            <TextBlock Text="⌨ 키보드 단축키" FontSize="16" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimary}"/>
                            <TextBlock Text="PaneDock에서 지원하는 Windows 탐색기 단축키"
                                       FontSize="11" Margin="0,3,0,0"
                                       Foreground="{DynamicResource TextSecondary}"/>
                        </StackPanel>
                    </DockPanel>
                    <ScrollViewer Grid.Row="1" x:Name="ShortcutHelpScroll"
                                  MaxHeight="380" HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="ShortcutHelpGroupsList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="10" Margin="0,0,5,8" CornerRadius="6"
                                            Background="{DynamicResource PanelBackground}">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Title}" FontSize="12"
                                                       Margin="0,0,0,5" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource AccentBrush}"/>
                                            <ItemsControl ItemsSource="{Binding Entries}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Margin="0,3,0,3">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="205"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="{Binding Keys}" Grid.Column="0"
                                                                       VerticalAlignment="Center"
                                                                       FontSize="11" FontWeight="SemiBold"
                                                                       Foreground="{DynamicResource TextPrimary}"/>
                                                            <TextBlock Text="{Binding Description}" Grid.Column="1"
                                                                       VerticalAlignment="Center"
                                                                       FontSize="11" TextWrapping="Wrap"
                                                                       Foreground="{DynamicResource TextSecondary}"/>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <TextBlock Grid.Row="2" Margin="2,9,0,0" FontSize="10"
                               Foreground="{DynamicResource TextSecondary}"
                               TextWrapping="Wrap"
                               Text="※ 선택 파일 명령은 파일 목록에 포커스가 있을 때 사용합니다. 주소창·필터 입력 중에는 기본 텍스트 편집 단축키가 적용됩니다."/>
                </Grid>
            </Border>
        </Popup>
    </Grid>
</Window>
