<Window x:Class="PaneDock.App.BatchRenameWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PaneDock · 파일명·확장자 일괄 변경" Icon="Assets/PaneDock.ico"
        Width="1100" Height="790" MinWidth="820" MinHeight="610"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackground}"
        Foreground="{DynamicResource TextPrimary}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="115"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <DockPanel Grid.Row="0" Margin="0,0,0,8" LastChildFill="True">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="파일 선택…" Padding="10,3" Click="ChooseFiles_Click" Margin="0,0,6,0"/>
                <Button Content="현재 폴더 전체" Padding="10,3" Click="LoadFolder_Click" Margin="0,0,6,0"/>
                <Button Content="선택 제거" Padding="10,3" Click="RemoveFiles_Click" Margin="0,0,6,0"/>
                <Button Content="초기화" Padding="10,3" Click="ClearFiles_Click"/>
            </StackPanel>
            <TextBlock Text="변경할 파일 선택 (여러 파일 가능)" VerticalAlignment="Center"
                       FontWeight="SemiBold" Margin="0,0,8,0"/>
        </DockPanel>
        <ListBox Grid.Row="1" x:Name="FilesList" SelectionMode="Extended"
                 ScrollViewer.HorizontalScrollBarVisibility="Auto"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 Background="{DynamicResource PanelBackground}"
                 Foreground="{DynamicResource TextPrimary}"/>
        <Grid Grid.Row="2" Margin="0,12,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                <TextBlock Text="찾을 문자열" Margin="0,0,0,3"/>
                <TextBox x:Name="FindBox" Height="28" TextChanged="Settings_Changed"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Margin="0,0,8,0">
                <TextBlock Text="바꿀 문자열" Margin="0,0,0,3"/>
                <TextBox x:Name="ReplaceBox" Height="28" TextChanged="Settings_Changed"/>
            </StackPanel>
            <StackPanel Grid.Column="2" Margin="0,0,8,0">
                <TextBlock Text="파일명 접두사" Margin="0,0,0,3"/>
                <TextBox x:Name="PrefixBox" Height="28" TextChanged="Settings_Changed"/>
            </StackPanel>
            <StackPanel Grid.Column="3">
                <TextBlock Text="파일명 접미사" Margin="0,0,0,3"/>
                <TextBox x:Name="SuffixBox" Height="28" TextChanged="Settings_Changed"/>
            </StackPanel>
        </Grid>
        <Grid Grid.Row="3" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="160"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <CheckBox Grid.Column="0" x:Name="ChangeExtensionBox"
                      Content="확장자 변경" Margin="0,0,12,0"
                      VerticalAlignment="Center"
                      Checked="Settings_Changed" Unchecked="Settings_Changed"/>
            <TextBox Grid.Column="1" x:Name="ExtensionBox" Height="28"
                     IsEnabled="False" TextChanged="Settings_Changed"
                     ToolTip="예: .csv 또는 csv / 빈 값이면 확장자 제거"/>
            <TextBlock Grid.Column="2" Margin="12,0,0,0" VerticalAlignment="Center"
                       Foreground="{DynamicResource TextSecondary}"
                       Text="미리보기는 파일을 변경하지 않습니다. 충돌이 한 건이라도 있으면 실행을 차단합니다."/>
        </Grid>
        <DockPanel Grid.Row="4" Margin="0,0,0,9">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button x:Name="PreviewButton" Content="미리보기" Padding="14,5"
                        Click="Preview_Click" Margin="0,0,8,0"/>
                <Button x:Name="ApplyButton" Content="변경 실행" IsEnabled="False"
                        Padding="14,5" Click="Apply_Click" Margin="0,0,8,0"/>
                <Button x:Name="UndoButton" Content="마지막 변경 되돌리기" IsEnabled="False"
                        Padding="14,5" Click="Undo_Click" Margin="0,0,8,0"/>
                <Button x:Name="CancelButton" Content="작업 중지" IsEnabled="False"
                        Padding="14,5" Click="Cancel_Click"/>
            </StackPanel>
            <TextBlock Text="변경 미리보기" VerticalAlignment="Center" FontWeight="SemiBold"/>
        </DockPanel>
        <DataGrid Grid.Row="5" x:Name="PreviewGrid" AutoGenerateColumns="False"
                  IsReadOnly="True" EnableRowVirtualization="True"
                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                  Background="{DynamicResource PanelBackground}"
                  Foreground="{DynamicResource TextPrimary}"
                  GridLinesVisibility="None">
            <DataGrid.Columns>
                <DataGridTextColumn Header="기존 파일명" Binding="{Binding OriginalName}"
                                    Width="SizeToCells" MinWidth="180" MaxWidth="900"/>
                <DataGridTextColumn Header="변경 후" Binding="{Binding NewName}"
                                    Width="SizeToCells" MinWidth="180" MaxWidth="900"/>
                <DataGridTextColumn Header="폴더" Binding="{Binding Folder}"
                                    Width="SizeToCells" MinWidth="250" MaxWidth="1500"/>
                <DataGridTextColumn Header="검사 결과" Binding="{Binding Status}" Width="2*"/>
            </DataGrid.Columns>
        </DataGrid>
        <TextBlock Grid.Row="6" x:Name="StatusText" Margin="0,10,0,0"
                   Text="파일을 선택하고 변경 규칙을 입력한 뒤 미리보기를 실행하세요."
                   TextWrapping="Wrap" Foreground="{DynamicResource TextSecondary}"/>
    </Grid>
</Window>
