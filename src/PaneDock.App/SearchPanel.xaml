<UserControl x:Class="PaneDock.App.SearchPanel"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Background="Transparent"
        Foreground="{DynamicResource TextPrimary}"
        PreviewKeyDown="SearchPanel_KeyDown">
    <Border Background="{DynamicResource CardBackground}"
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
            CornerRadius="8" Padding="12">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <DockPanel Grid.Row="0" Margin="0,0,0,10">
            <Button DockPanel.Dock="Right" x:Name="CloseSearchButton" Content="×"
                    ToolTip="검색 팝업 닫기 (Esc)" Width="30" Height="27"
                    Padding="0" Click="CloseSearch_Click"/>
            <TextBlock Text="⌕  전체 파일 검색" FontSize="14" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimary}"
                       VerticalAlignment="Center"/>
        </DockPanel>
        <!-- The title-bar search box is the single search input. -->
        <Grid Grid.Row="1" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="검색어" VerticalAlignment="Center" Margin="0,0,10,0" FontWeight="SemiBold"/>
            <TextBox Grid.Column="1" x:Name="QueryBox" Height="32"
                     VerticalContentAlignment="Center" KeyDown="Query_KeyDown"
                     TextChanged="SearchInputs_Changed"
                     ToolTip="Everything 검색 문법 지원: *.pdf, 이름1 이름2, 파일명 일부 입력"/>
            <Button Grid.Column="2" x:Name="SearchButton" Content="⌕ 검색"
                    Margin="8,0,0,0" Padding="18,4" Click="Search_Click"/>
        </Grid>
        <Grid Grid.Row="2" Margin="0,10,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="검색 위치 (선택)" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <TextBox Grid.Column="1" x:Name="RootBox" Height="29" VerticalContentAlignment="Center"
                     TextChanged="SearchInputs_Changed"
                     ToolTip="비우면 전체 PC의 사용 가능한 드라이브에서 검색. 특정 C:\, D:\ 또는 네트워크 공유 경로도 입력 가능"/>
            <Button Grid.Column="2" x:Name="CurrentFolderButton" Content="현재 폴더"
                    Margin="8,0,0,0" Padding="10,3" Click="CurrentFolder_Click"
                    ToolTip="검색 범위를 활성 패널의 현재 폴더로 제한"/>
            <CheckBox Grid.Column="3" x:Name="RecursiveBox" IsChecked="True"
                      Content="하위 폴더 포함" VerticalAlignment="Center" Margin="10,0,8,0"
                      Checked="SearchScope_Changed" Unchecked="SearchScope_Changed"/>
            <CheckBox Grid.Column="4" x:Name="DirectScanBox"
                      Content="직접 검색 (느림)" VerticalAlignment="Center" Margin="0,0,8,0"
                      Checked="SearchScope_Changed" Unchecked="SearchScope_Changed"
                      ToolTip="선택 시에만 디스크를 직접 순회합니다. 전체 드라이브 검색은 오래 걸릴 수 있습니다."/>
            <Button Grid.Column="5" x:Name="CancelButton" Content="중지"
                    Click="Cancel_Click" IsEnabled="False" Padding="14,3"/>
        </Grid>
        <DataGrid Grid.Row="3" x:Name="ResultGrid" IsReadOnly="True" AutoGenerateColumns="False"
                  EnableRowVirtualization="True" SelectionMode="Extended" SelectionUnit="FullRow"
                  SelectionChanged="Results_SelectionChanged"
                  PreviewKeyDown="Results_KeyDown"
                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                  Background="{DynamicResource PanelBackground}"
                  Foreground="{DynamicResource TextPrimary}"
                  RowBackground="{DynamicResource PanelBackground}"
                  AlternatingRowBackground="{DynamicResource PanelBackground}"
                  GridLinesVisibility="None"
                  MouseDoubleClick="Results_DoubleClick">
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Setter Property="Background" Value="{DynamicResource PanelBackground}"/>
                    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                    <Style.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="{DynamicResource SelectionBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.CellStyle>
                <Style TargetType="DataGridCell">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Style.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="{DynamicResource SelectionBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.CellStyle>
            <DataGrid.ColumnHeaderStyle>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="{DynamicResource CardBackground}"/>
                    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                    <Setter Property="Padding" Value="8,5"/>
                </Style>
            </DataGrid.ColumnHeaderStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="이름" Binding="{Binding Name}" Width="SizeToCells"
                                    MinWidth="170" MaxWidth="850"/>
                <DataGridTextColumn Header="경로" Binding="{Binding FolderPath}" Width="SizeToCells"
                                    MinWidth="250" MaxWidth="1500"/>
                <DataGridTextColumn Header="유형" Binding="{Binding Type}" Width="65"/>
                <DataGridTextColumn Header="크기" Binding="{Binding SizeText}" Width="100"/>
                <DataGridTextColumn Header="수정 날짜" Binding="{Binding ModifiedText}" Width="140"/>
            </DataGrid.Columns>
        </DataGrid>
        <DockPanel Grid.Row="4" Margin="0,10,0,0" LastChildFill="True">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="위치 열기" Padding="14,4" Margin="0,0,8,0"
                        Click="OpenLocation_Click" ToolTip="선택 항목의 부모 폴더를 PaneDock에서 열기"/>
                <Button Content="파일 열기" Padding="14,4" Margin="0,0,8,0"
                        Click="OpenResult_Click"
                        ToolTip="Windows 연결 프로그램에서 파일 또는 폴더 열기"/>
                <Button x:Name="DeleteResultsButton" Content="선택 삭제" Padding="14,4"
                        IsEnabled="False" Click="DeleteSelected_Click"
                        ToolTip="선택한 항목을 휴지통으로 이동 (Delete 키)"/>
            </StackPanel>
            <StackPanel Orientation="Vertical">
                <TextBlock x:Name="StatusText" Text="검색어만 입력하면 PC 전체 드라이브에서 검색합니다. 경로를 입력하면 해당 폴더만 검색합니다."
                           Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap"/>
                <TextBlock x:Name="SelectionText" Text="선택 0개 · Ctrl/Shift 다중 선택 · Ctrl+A 전체 선택 · Delete 휴지통"
                           Margin="0,3,0,0" Foreground="{DynamicResource TextSecondary}"/>
            </StackPanel>
        </DockPanel>
    </Grid>
    </Border>
</UserControl>
