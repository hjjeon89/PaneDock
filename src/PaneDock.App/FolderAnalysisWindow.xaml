<Window x:Class="PaneDock.App.FolderAnalysisWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PaneDock · 다중 폴더 분석" Icon="Assets/PaneDock.ico"
        Width="960" Height="690" MinWidth="700" MinHeight="510"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackground}"
        Foreground="{DynamicResource TextPrimary}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="125"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Text="분석할 폴더 여러 개를 추가하세요. 상위·하위 경로 중복은 한 번만 계산합니다."
                   FontWeight="SemiBold" Margin="0,0,0,10"/>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox Grid.Column="0" x:Name="FolderPathBox" Height="30"
                     VerticalContentAlignment="Center" ToolTip="분석할 폴더의 전체 경로"
                     KeyDown="Path_KeyDown"/>
            <Button Grid.Column="1" Content="추가" Margin="8,0,0,0" Padding="12,3" Click="Add_Click"/>
            <Button Grid.Column="2" Content="선택 제거" Margin="8,0,0,0" Padding="12,3" Click="Remove_Click"/>
            <Button Grid.Column="3" Content="전체 지우기" Margin="8,0,0,0" Padding="12,3" Click="Clear_Click"/>
        </Grid>
        <ListBox Grid.Row="2" x:Name="FoldersBox" Margin="0,8,0,10"
                 SelectionMode="Extended" BorderThickness="1"
                 ScrollViewer.HorizontalScrollBarVisibility="Auto"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 Background="{DynamicResource PanelBackground}"
                 Foreground="{DynamicResource TextPrimary}"/>
        <DockPanel Grid.Row="3" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                <Button x:Name="StartButton" Content="분석 시작" Padding="16,4"
                        Click="Start_Click" Margin="0,0,8,0"/>
                <Button x:Name="CancelButton" Content="중지" IsEnabled="False"
                        Padding="16,4" Click="Cancel_Click"/>
            </StackPanel>
            <TextBlock Text="폴더별 파일 수 · 하위 폴더 수 · 전체 용량"
                       VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}"/>
        </DockPanel>
        <DataGrid Grid.Row="4" x:Name="ResultsGrid" AutoGenerateColumns="False"
                  IsReadOnly="True" EnableRowVirtualization="True"
                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                  Background="{DynamicResource PanelBackground}"
                  Foreground="{DynamicResource TextPrimary}"
                  GridLinesVisibility="None">
            <DataGrid.Columns>
                <DataGridTextColumn Header="폴더 경로" Binding="{Binding Path}"
                                    Width="SizeToCells" MinWidth="250" MaxWidth="1500"/>
                <DataGridTextColumn Header="파일 수" Binding="{Binding FileCount, StringFormat=N0}" Width="100"/>
                <DataGridTextColumn Header="하위 폴더" Binding="{Binding SubfolderCount, StringFormat=N0}" Width="100"/>
                <DataGridTextColumn Header="총용량" Binding="{Binding SizeText}" Width="115"/>
                <DataGridTextColumn Header="건너뜀" Binding="{Binding SkippedFolders}" Width="80"/>
                <DataGridTextColumn Header="오류" Binding="{Binding Error}" Width="150"/>
            </DataGrid.Columns>
        </DataGrid>
        <TextBlock Grid.Row="5" x:Name="StatusText"
                   Margin="0,10,0,0" Text="폴더를 추가한 뒤 분석 시작을 누르세요."
                   Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap"/>
    </Grid>
</Window>
