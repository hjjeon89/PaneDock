<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="MSTest.TestAdapter" Version="3.6.4" />
    <PackageReference Include="MSTest.TestFramework" Version="3.6.4" />
    <ProjectReference Include="..\..\src\PaneDock.Core\PaneDock.Core.csproj" />
    <Content Include="..\..\src\PaneDock.App\Native\Everything64.dll"
             Link="Everything64.dll" CopyToOutputDirectory="PreserveNewest" />
    <!-- Verify the actual Shell implementation without adding a WPF dependency to Core. -->
    <Compile Include="..\..\src\PaneDock.App\ShellFileOperation.cs" Link="ShellFileOperation.cs" />
    <Compile Include="..\..\src\PaneDock.App\Controls\ShellIconConverter.cs"
             Link="ShellIconConverter.cs" />
    <Using Include="System.IO" />
  </ItemGroup>
</Project>
